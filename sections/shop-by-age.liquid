{% comment %}
  Shop by age — an editorial category grid.

  Nobody shops a children's store by browsing everything. They arrive knowing
  one thing: how old the child is. So age is the first cut, not a filter buried
  three clicks in, and the first card is given twice the room because there is
  always one category doing most of the work.

  Images come from the collection itself, falling back to its first product, so
  the grid fills in as soon as collections are picked — no separate uploads to
  keep in sync.
{% endcomment %}

{%- liquid
  comment
    A slot only counts once its collection actually resolves. A handle that no
    longer exists must drop out of the layout rather than leave a hole in it.
  endcomment
  assign slots = ''
  for i in (1..5)
    assign key = 'collection_' | append: i
    assign picked = section.settings[key]
    if picked.title == blank and picked != blank
      assign picked = collections[picked]
    endif
    if picked.title != blank
      assign slots = slots | append: i | append: ','
    endif
  endfor
  assign slots = slots | split: ','

  comment
    Nothing picked yet — show the store's own collections rather than an empty
    band. A homepage that renders on install is worth more than one that waits
    to be configured.
  endcomment
  assign auto = false
  assign count = slots.size
  if count == 0
    assign auto = true
    assign count = collections.size
    if count > 5
      assign count = 5
    endif
  endif
-%}

{%- if count > 0 -%}
  <div
    class="pl-ages"
    style="
      --pl-sand: {{ section.settings.accent_color }};
      --pl-ink: {{ section.settings.text_color }};
      --pl-bg: {{ section.settings.background_color }};
      --pl-pad-start: {{ section.settings.padding_block_start }}px;
      --pl-pad-end: {{ section.settings.padding_block_end }}px;
      --pl-radius: {{ section.settings.corner_radius }}px;
    "
  >
    <div class="pl-ages__inner">
      <header class="pl-ages__head">
        <div class="pl-ages__headtext">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pl-ages__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pl-ages__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="pl-ages__sub">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
          <a class="pl-ages__all" href="{{ section.settings.link_url }}">
            {{ section.settings.link_label | escape }}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </header>

      <div class="pl-ages__grid pl-ages__grid--{{ count }}">
        {%- if auto -%}
          {%- for c in collections limit: 5 -%}
            {% render 'pl-age-card',
              collection: c,
              lead: forloop.first,
              show_count: section.settings.show_count
            %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in slots -%}
            {%- liquid
              assign col_key = 'collection_' | append: i
              assign label_key = 'label_' | append: i

              assign picked = section.settings[col_key]
              if picked.title == blank
                assign picked = collections[picked]
              endif
            -%}
            {% render 'pl-age-card',
              collection: picked,
              label: section.settings[label_key],
              lead: forloop.first,
              show_count: section.settings.show_count
            %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .pl-ages {
    background: var(--pl-bg);
    color: var(--pl-ink);
    padding-block: var(--pl-pad-start) var(--pl-pad-end);
  }

  .pl-ages__inner {
    width: 100%;
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 20px);
  }

  .pl-ages__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--padding-2xl, 1.5rem);
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
  }

  .pl-ages__headtext {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-inline-size: 46ch;
  }

  .pl-ages__eyebrow {
    margin: 0;
    font-size: var(--font-size--xs, 0.8125rem);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--pl-ink) 55%, transparent);
  }

  .pl-ages__heading {
    margin: 0;
    font-family: var(--font-h2--family, inherit);
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: var(--font-h2--weight, 500);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .pl-ages__sub {
    margin: 0;
    font-size: var(--font-size--md, 1rem);
    line-height: 1.55;
    color: color-mix(in srgb, var(--pl-ink) 65%, transparent);
    text-wrap: pretty;
  }

  .pl-ages__all {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    padding-block-end: 0.35rem;
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--pl-ink);
    text-decoration: none;
    border-block-end: 1px solid color-mix(in srgb, var(--pl-ink) 25%, transparent);
    transition: border-color 0.2s ease, gap 0.2s ease;
  }

  .pl-ages__all:hover {
    gap: 0.7rem;
    border-block-end-color: var(--pl-ink);
  }

  /* Four columns, two rows: the lead category takes the left half, the other
     four sit as a 2x2 block beside it. Anything other than five items falls
     back to an even grid rather than leaving a hole. */
  .pl-ages__grid {
    display: grid;
    gap: clamp(0.5rem, 1vw, 0.9rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pl-ages__card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--pl-radius, 4px);
    background: color-mix(in srgb, var(--pl-sand) 30%, transparent);
    text-decoration: none;
    color: inherit;
    aspect-ratio: 3 / 4;
    isolation: isolate;
  }

  .pl-ages__media {
    position: absolute;
    inset: 0;
    display: block;
  }

  .pl-ages__img,
  .pl-ages__placeholder-svg {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .pl-ages__placeholder {
    display: block;
    block-size: 100%;
    background: color-mix(in srgb, var(--pl-sand) 45%, transparent);
  }

  .pl-ages__placeholder-svg {
    fill: color-mix(in srgb, var(--pl-ink) 22%, transparent);
  }

  .pl-ages__card:hover .pl-ages__img {
    transform: scale(1.045);
  }

  /* A scrim rather than a flat overlay: the photograph stays a photograph and
     only the strip under the name gets darkened enough to read on. */
  .pl-ages__card::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 58%;
    background: linear-gradient(to top, rgb(20 18 16 / 0.66), rgb(20 18 16 / 0.22) 45%, transparent);
    pointer-events: none;
    z-index: 1;
  }

  .pl-ages__label {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: clamp(0.9rem, 1.8vw, 1.4rem);
    color: #fff;
  }

  .pl-ages__name {
    font-family: var(--font-h3--family, inherit);
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.005em;
    /* The sand underline is the only brand colour on the card, and it draws
       itself in on hover rather than sitting there as decoration. */
    background-image: linear-gradient(var(--pl-sand), var(--pl-sand));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 2px;
    padding-block-end: 3px;
    transition: background-size 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
    align-self: flex-start;
  }

  .pl-ages__card:hover .pl-ages__name,
  .pl-ages__card:focus-visible .pl-ages__name {
    background-size: 100% 2px;
  }

  .pl-ages__count {
    font-size: var(--font-size--xs, 0.8125rem);
    letter-spacing: 0.05em;
    color: rgb(255 255 255 / 0.78);
  }

  .pl-ages__card:focus-visible {
    outline: 2px solid var(--pl-ink);
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .pl-ages__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* Five is the shape this grid was drawn for: the lead fills the left half
       and the other four stack 2x2 beside it. */
    .pl-ages__grid--5 .pl-ages__card--lead {
      grid-column: span 2;
      grid-row: span 2;
      aspect-ratio: auto;
    }

    /* Three reads better as a wide lead with two tall cards under it than as
       one short row. */
    .pl-ages__grid--3 .pl-ages__card--lead {
      grid-column: span 2;
      grid-row: span 2;
      aspect-ratio: auto;
    }

    .pl-ages__grid--3 .pl-ages__card:not(.pl-ages__card--lead) {
      grid-column: span 2;
    }

    /* Two and four divide evenly, so the lead takes no special billing. */
    .pl-ages__grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .pl-ages__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    /* The lead card keeps its billing on a phone by running full width. */
    .pl-ages__card--lead {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-ages__img,
    .pl-ages__name,
    .pl-ages__all {
      transition: none;
    }

    .pl-ages__card:hover .pl-ages__img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by age",
  "tag": "section",
  "class": "pl-ages-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by age" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every stage, beautifully dressed" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From first babygrows to first school shoes — pick an age and we will take it from there."
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View everything" },
    { "type": "url", "id": "link_url", "label": "Link" },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show how many pieces are in each collection",
      "default": true
    },
    {
      "type": "header",
      "content": "Categories",
      "info": "The first one is given the large card. Leave a slot empty to drop it."
    },
    { "type": "collection", "id": "collection_1", "label": "Category 1 (large)" },
    { "type": "text", "id": "label_1", "label": "Override label 1", "info": "Defaults to the collection title." },
    { "type": "collection", "id": "collection_2", "label": "Category 2" },
    { "type": "text", "id": "label_2", "label": "Override label 2" },
    { "type": "collection", "id": "collection_3", "label": "Category 3" },
    { "type": "text", "id": "label_3", "label": "Override label 3" },
    { "type": "collection", "id": "collection_4", "label": "Category 4" },
    { "type": "text", "id": "label_4", "label": "Override label 4" },
    { "type": "collection", "id": "collection_5", "label": "Category 5" },
    { "type": "text", "id": "label_5", "label": "Override label 5" },
    { "type": "header", "content": "Appearance" },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0, "max": 28, "step": 2, "unit": "px",
      "default": 4
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2926" },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Matches the AI chat button by default.",
      "default": "#d8c9b6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range", "id": "padding_block_start", "label": "Top",
      "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72
    },
    {
      "type": "range", "id": "padding_block_end", "label": "Bottom",
      "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72
    }
  ],
  "presets": [{ "name": "Shop by age", "category": "Collections" }]
}
{% endschema %}
