{% comment %}
  Craft story — the editorial split that explains the price.

  A £120 pair of children's shoes needs a reason, and the reason is never a
  bullet list of features. So: one photograph given real room, a short piece of
  writing beside it, and underneath, three plain facts a sceptical parent can
  check — where it was made, what it is made of, how long it lasts.

  The sand block behind the photograph is the only flourish. It is offset, not
  centred, because a frame that lines up perfectly stops reading as a deliberate
  hand and starts reading as a border.
{% endcomment %}

{%- liquid
  comment
    Prefer an uploaded photograph, but fall back to the store's own imagery so
    the section never opens on a grey placeholder before someone gets round to
    art-directing it.
  endcomment
  assign image = section.settings.image

  unless image
    assign source = section.settings.fallback_collection
    if source.title == blank and source != blank
      assign source = collections[source]
    endif
    assign image = source.image
    unless image
      assign image = source.products.first.featured_image
    endunless
  endunless

  assign facts = ''
  for i in (1..3)
    assign key = 'fact_' | append: i | append: '_label'
    if section.settings[key] != blank
      assign facts = facts | append: i | append: ','
    endif
  endfor
  assign facts = facts | split: ','
-%}

<div
  class="pl-craft{% if section.settings.reverse %} pl-craft--reverse{% endif %}"
  style="
    --pl-sand: {{ section.settings.accent_color }};
    --pl-ink: {{ section.settings.text_color }};
    --pl-bg: {{ section.settings.background_color }};
    --pl-pad-start: {{ section.settings.padding_block_start }}px;
    --pl-pad-end: {{ section.settings.padding_block_end }}px;
  "
>
  <div class="pl-craft__inner">
    <div class="pl-craft__media">
      <span class="pl-craft__frame" aria-hidden="true"></span>
      {%- if image -%}
        <img
          src="{{ image | image_url: width: 1000 }}"
          srcset="
            {{ image | image_url: width: 500 }} 500w,
            {{ image | image_url: width: 800 }} 800w,
            {{ image | image_url: width: 1200 }} 1200w
          "
          sizes="(min-width: 900px) 46vw, 100vw"
          alt="{{ image.alt | default: section.settings.heading | escape }}"
          width="{{ image.width }}"
          height="{{ image.height }}"
          loading="lazy"
          class="pl-craft__img"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'pl-craft__img pl-craft__img--placeholder' }}
      {%- endif -%}
    </div>

    <div class="pl-craft__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pl-craft__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="pl-craft__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="pl-craft__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if facts.size > 0 -%}
        <dl class="pl-craft__facts">
          {%- for i in facts -%}
            {%- liquid
              assign label_key = 'fact_' | append: i | append: '_label'
              assign value_key = 'fact_' | append: i | append: '_value'
            -%}
            <div class="pl-craft__fact">
              <dt>{{ section.settings[label_key] | escape }}</dt>
              <dd>{{ section.settings[value_key] | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
        <a class="pl-craft__btn" href="{{ section.settings.button_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pl-craft {
    background: var(--pl-bg);
    color: var(--pl-ink);
    padding-block: var(--pl-pad-start) var(--pl-pad-end);
  }

  .pl-craft__inner {
    width: 100%;
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 20px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5.5rem);
  }

  .pl-craft--reverse .pl-craft__media {
    order: 2;
  }

  /* ── Photograph ─────────────────────────────────── */
  .pl-craft__media {
    position: relative;
    /* Room for the offset block to sit outside the photograph's own box. */
    padding: 0 var(--pl-offset, 22px) var(--pl-offset, 22px) 0;
  }

  .pl-craft--reverse .pl-craft__media {
    padding: 0 0 var(--pl-offset, 22px) var(--pl-offset, 22px);
  }

  .pl-craft__frame {
    position: absolute;
    inset-block: var(--pl-offset, 22px) 0;
    inset-inline: var(--pl-offset, 22px) 0;
    background: var(--pl-sand);
    border-radius: 3px;
  }

  .pl-craft--reverse .pl-craft__frame {
    inset-inline: 0 var(--pl-offset, 22px);
  }

  .pl-craft__img {
    position: relative;
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 3px;
  }

  .pl-craft__img--placeholder {
    background: color-mix(in srgb, var(--pl-sand) 45%, transparent);
    fill: color-mix(in srgb, var(--pl-ink) 20%, transparent);
  }

  /* ── Copy ───────────────────────────────────────── */
  .pl-craft__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-inline-size: 52ch;
  }

  .pl-craft__eyebrow {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--font-size--xs, 0.8125rem);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--pl-ink) 58%, transparent);
  }

  /* A short sand rule leading into the eyebrow, so the column has a start. */
  .pl-craft__eyebrow::before {
    content: "";
    inline-size: 28px;
    block-size: 2px;
    background: var(--pl-sand);
    flex: none;
  }

  .pl-craft__heading {
    margin: 0;
    font-family: var(--font-h2--family, inherit);
    font-size: clamp(1.85rem, 3.4vw, 2.9rem);
    font-weight: var(--font-h2--weight, 500);
    line-height: 1.08;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .pl-craft__text {
    font-size: var(--font-size--md, 1rem);
    line-height: 1.68;
    color: color-mix(in srgb, var(--pl-ink) 72%, transparent);
    text-wrap: pretty;
  }

  .pl-craft__text > :first-child { margin-block-start: 0; }
  .pl-craft__text > :last-child { margin-block-end: 0; }

  /* ── The three checkable facts ──────────────────── */
  .pl-craft__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
    gap: 0;
    margin: 0.6rem 0 0;
    inline-size: 100%;
    border-block-start: 1px solid color-mix(in srgb, var(--pl-ink) 14%, transparent);
  }

  .pl-craft__fact {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-block: 0.95rem;
    padding-inline-end: 1.2rem;
    border-block-end: 1px solid color-mix(in srgb, var(--pl-ink) 14%, transparent);
  }

  .pl-craft__fact dt {
    font-size: var(--font-size--2xs, 0.75rem);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--pl-ink) 52%, transparent);
  }

  .pl-craft__fact dd {
    margin: 0;
    font-size: var(--font-size--md, 1rem);
    font-weight: 500;
    line-height: 1.35;
  }

  /* ── Button ─────────────────────────────────────── */
  .pl-craft__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-block-start: 0.5rem;
    padding: 0.85rem 1.9rem;
    border: 1px solid var(--pl-ink);
    border-radius: 999px;
    background: transparent;
    color: var(--pl-ink);
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.22s ease, color 0.22s ease;
  }

  .pl-craft__btn:hover {
    background: var(--pl-ink);
    color: var(--pl-bg);
  }

  .pl-craft__btn:focus-visible {
    outline: 2px solid var(--pl-ink);
    outline-offset: 3px;
  }

  @media screen and (max-width: 899px) {
    .pl-craft__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.75rem, 6vw, 2.75rem);
    }

    /* Photograph first on a phone whichever way the desktop was ordered. */
    .pl-craft--reverse .pl-craft__media {
      order: 0;
    }

    .pl-craft__body {
      max-inline-size: none;
    }

    .pl-craft__img {
      aspect-ratio: 3 / 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-craft__btn { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Craft story",
  "tag": "section",
  "class": "pl-craft-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Or take a photo from",
      "info": "Used when no photograph is uploaded. Falls back to the collection image, then its first product."
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Put the photograph on the right",
      "default": false
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our workshops" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made slowly, in Spain" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every pair of our Mary Janes is cut, stitched and finished by hand in the same small Spanish workshops we have worked with for years. Full-grain leather, a leather sole, and stitching you can count.</p><p>It is slower than the alternative, and it is why these are the shoes that get handed down to the next one.</p>"
    },
    { "type": "header", "content": "The facts" },
    { "type": "text", "id": "fact_1_label", "label": "Fact 1 label", "default": "Made in" },
    { "type": "text", "id": "fact_1_value", "label": "Fact 1 value", "default": "Elche, Spain" },
    { "type": "text", "id": "fact_2_label", "label": "Fact 2 label", "default": "Materials" },
    { "type": "text", "id": "fact_2_value", "label": "Fact 2 value", "default": "100% full-grain leather" },
    { "type": "text", "id": "fact_3_label", "label": "Fact 3 label", "default": "Sizes" },
    { "type": "text", "id": "fact_3_value", "label": "Fact 3 value", "default": "EU 17 – 34" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Read our story" },
    { "type": "url", "id": "button_url", "label": "Link" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f5f1ea" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2926" },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Matches the AI chat button by default.",
      "default": "#d8c9b6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range", "id": "padding_block_start", "label": "Top",
      "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88
    },
    {
      "type": "range", "id": "padding_block_end", "label": "Bottom",
      "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88
    }
  ],
  "presets": [{ "name": "Craft story", "category": "Storytelling" }]
}
{% endschema %}
