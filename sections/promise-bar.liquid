{% comment %}
  Promise bar — the quiet strip of reassurances that sits under the hero.

  Deliberately not cards. A parent buying a £120 pair of leather shoes for a
  four-year-old is scanning for four answers (who made it, when does it come,
  can I send it back, will it arrive gift-wrapped). Hairline rules separate
  them without turning each one into an object competing with the product
  photography above.

  Palette is locked to the AI support chat's own accent so the two read as one
  system rather than two vendors.
{% endcomment %}

{%- liquid
  assign items = ''
  for i in (1..4)
    assign title_key = 'item_' | append: i | append: '_title'
    if section.settings[title_key] != blank
      assign items = items | append: i | append: ','
    endif
  endfor
  assign items = items | split: ','
-%}

{%- if items.size > 0 -%}
  <div
    class="pl-promise"
    style="
      --pl-sand: {{ section.settings.accent_color }};
      --pl-ink: {{ section.settings.text_color }};
      --pl-bg: {{ section.settings.background_color }};
      --pl-pad-start: {{ section.settings.padding_block_start }}px;
      --pl-pad-end: {{ section.settings.padding_block_end }}px;
    "
  >
    <div class="pl-promise__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="pl-promise__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul class="pl-promise__list" style="--pl-count: {{ items.size }};">
        {%- for i in items -%}
          {%- liquid
            assign icon_key = 'item_' | append: i | append: '_icon'
            assign title_key = 'item_' | append: i | append: '_title'
            assign text_key = 'item_' | append: i | append: '_text'
            assign icon_name = section.settings[icon_key]
          -%}
          <li class="pl-promise__item">
            <span class="pl-promise__icon">
              {% render 'pl-icon', name: icon_name, size: 24 %}
            </span>
            <span class="pl-promise__copy">
              <span class="pl-promise__title">{{ section.settings[title_key] | escape }}</span>
              {%- if section.settings[text_key] != blank -%}
                <span class="pl-promise__text">{{ section.settings[text_key] | escape }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .pl-promise {
    background: var(--pl-bg);
    padding-block: var(--pl-pad-start) var(--pl-pad-end);
    color: var(--pl-ink);
  }

  .pl-promise__inner {
    width: 100%;
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 20px);
  }

  .pl-promise__heading {
    font-family: var(--font-h3--family, inherit);
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: color-mix(in srgb, var(--pl-ink) 62%, transparent);
    margin: 0 0 var(--padding-2xl, 1.5rem);
  }

  .pl-promise__list {
    display: grid;
    grid-template-columns: repeat(var(--pl-count, 4), minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pl-promise__item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding-inline: clamp(0.75rem, 2.2vw, 1.75rem);
    /* The rule belongs between items, so the first one does not get one. */
    border-inline-start: 1px solid color-mix(in srgb, var(--pl-ink) 12%, transparent);
  }

  .pl-promise__item:first-child {
    border-inline-start: 0;
    padding-inline-start: 0;
  }

  .pl-promise__item:last-child {
    padding-inline-end: 0;
  }

  .pl-promise__icon {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    flex: none;
    border-radius: 50%;
    /* The sand ring is the one place this strip spends colour. */
    background: color-mix(in srgb, var(--pl-sand) 34%, transparent);
    color: color-mix(in srgb, var(--pl-ink) 78%, transparent);
  }

  .pl-promise__copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-inline-size: 0;
    padding-block-start: 0.35rem;
  }

  .pl-promise__title {
    font-family: var(--font-body--family, inherit);
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .pl-promise__text {
    font-size: var(--font-size--xs, 0.8125rem);
    line-height: 1.45;
    color: color-mix(in srgb, var(--pl-ink) 60%, transparent);
    text-wrap: pretty;
  }

  @media screen and (max-width: 1100px) {
    .pl-promise__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--padding-2xl, 1.5rem) 0;
    }

    /* On two columns the rule only makes sense down the middle. */
    .pl-promise__item:nth-child(odd) {
      border-inline-start: 0;
      padding-inline-start: 0;
    }

    .pl-promise__item:nth-child(even) {
      padding-inline-end: 0;
    }
  }

  @media screen and (max-width: 560px) {
    .pl-promise__list {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--padding-xl, 1.25rem);
    }

    .pl-promise__item,
    .pl-promise__item:nth-child(even) {
      border-inline-start: 0;
      padding-inline: 0;
    }

    .pl-promise__icon {
      inline-size: 34px;
      block-size: 34px;
    }

    .pl-promise__icon svg {
      inline-size: 20px;
      block-size: 20px;
    }
  }
{% endstylesheet %}

