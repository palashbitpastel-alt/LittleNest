{%- doc -%}
  A small line-art icon, drawn rather than set in a font so it inherits
  `currentColor` and stays crisp at any size.

  Kept deliberately spare: one weight, round caps, no fills. Anything heavier
  competes with the product photography it sits beside.

  @param {string} name - Which icon to draw. Unknown names draw nothing.
  @param {string} [size] - Pixel size of the square. Defaults to 22.

  @example
  {% render 'pl-icon', name: 'gift', size: 20 %}
{%- enddoc -%}

{%- liquid
  assign px = size | default: 22
-%}
{%- capture attrs -%}
  width="{{ px }}" height="{{ px }}" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
  stroke-linejoin="round" aria-hidden="true" focusable="false"
{%- endcapture -%}

{%- case name -%}
  {%- when 'needle' -%}
    <svg {{ attrs }}><path d="M3 21 21 3"/><path d="M14.5 3.5a3.5 3.5 0 0 1 5 5L18 10l-4-4z"/><circle cx="6" cy="18" r="1.6"/></svg>
  {%- when 'truck' -%}
    <svg {{ attrs }}><path d="M2 7h11v9H2z"/><path d="M13 10h4l4 3.5V16h-8z"/><circle cx="6.5" cy="18.5" r="1.9"/><circle cx="17.5" cy="18.5" r="1.9"/></svg>
  {%- when 'return' -%}
    <svg {{ attrs }}><path d="M3 10a8 8 0 1 1 2 5.3"/><path d="M3 4.5V10h5.5"/></svg>
  {%- when 'gift' -%}
    <svg {{ attrs }}><path d="M3 11h18v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M2 7.5h20V11H2z"/><path d="M12 7.5V21"/><path d="M12 7.5S10.6 3 8.3 3a2.2 2.2 0 0 0 0 4.5z"/><path d="M12 7.5S13.4 3 15.7 3a2.2 2.2 0 0 1 0 4.5z"/></svg>
  {%- when 'leaf' -%}
    <svg {{ attrs }}><path d="M4 20c0-8 5-13 16-14 0 10-5 15-13 15H4z"/><path d="M9 15c2.5-3 5-4.6 8-5.4"/></svg>
  {%- when 'shield' -%}
    <svg {{ attrs }}><path d="M12 3l7.5 3v5.6c0 4.5-3.1 8.1-7.5 9.4-4.4-1.3-7.5-4.9-7.5-9.4V6z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>
  {%- when 'heart' -%}
    <svg {{ attrs }}><path d="M12 20.3s-7.6-4.6-7.6-9.6A4.2 4.2 0 0 1 12 8.1a4.2 4.2 0 0 1 7.6 2.6c0 5-7.6 9.6-7.6 9.6z"/></svg>
  {%- when 'ruler' -%}
    <svg {{ attrs }}><path d="m3 15.5 8.5-8.5 5.5 5.5L8.5 21z" transform="translate(0 -1)"/><path d="M13 8.5 14.8 6.7"/><path d="M10.6 10.9 12.4 9.1"/><path d="M8.2 13.3 10 11.5"/><path d="m16.5 4.5 3 3"/></svg>
  {%- when 'sparkle' -%}
    <svg {{ attrs }}><path d="M12 3.5 13.8 9 19 10.8 13.8 12.6 12 18l-1.8-5.4L5 10.8 10.2 9z"/><path d="M18.5 16.5 19.2 18.4 21 19l-1.8.7-.7 1.8-.7-1.8L16 19l1.8-.6z"/></svg>
  {%- when 'clock' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="8.6"/><path d="M12 7.2V12l3.2 2"/></svg>
{%- endcase -%}
