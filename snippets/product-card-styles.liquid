{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    /* Extra inset for the text content area (title, price…) on top of the merchant padding settings. */
    --product-card-content-inset: var(--padding-md);
    padding-block: var(--padding-block-start) calc(var(--padding-block-end) + var(--product-card-content-inset));
    padding-inline: calc(var(--padding-inline-start) + var(--product-card-content-inset))
      calc(var(--padding-inline-end) + var(--product-card-content-inset));
    overflow: hidden;
    /* Soft card elevation; follows the active color scheme. Corner radius comes from the card's border_radius setting. */
    box-shadow: var(
      --product-card-shadow,
      0 2px 10px rgb(var(--color-foreground-rgb) / var(--opacity-10)),
      0 1px 2px rgb(var(--color-foreground-rgb) / var(--opacity-5))
    );
  }

  /* The content inset applies to the text area only; media stays edge-to-edge with the card. */
  .product-grid__card > .card-gallery {
    margin-inline: calc(-1 * var(--product-card-content-inset));
  }

  /* Zoom-out shows media only and uses its own card padding. */
  [product-grid-view='zoom-out'] .product-grid__card.product-grid__card {
    --product-card-content-inset: 0px;
  }

  /*
    Product cards are narrow, so group content stacks on mobile. A group that
    turns "vertical on mobile" off renders without .mobile-column and keeps the
    horizontal direction it was given.
  */
  .product-grid__card .group-block > :is(.mobile-column, :not(.layout-panel-flex--row)) {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
    }
  }

  /*
    Desktop scales the card title and price down from their block font size
    settings; mobile keeps the configured size. The size arrives as an inline
    --font-size, so the scaled value is applied to the block and its children.
  */
  @media screen and (min-width: 750px) {
    .product-grid__card {
      --product-card-text-scale: 0.9;
    }

    .product-grid__card :is([ref='productTitleLink'] > .text-block, product-price.text-block).custom-font-size,
    .product-grid__card
      :is([ref='productTitleLink'] > .text-block, product-price.text-block).custom-font-size
      > * {
      font-size: calc(var(--font-size) * var(--product-card-text-scale));
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
